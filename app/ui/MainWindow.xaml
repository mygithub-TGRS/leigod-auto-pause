<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="MainWindow"
    Title="雷神自动暂停（非官方）"
    Width="1040"
    Height="680"
    MinWidth="900"
    MinHeight="620"
    WindowStartupLocation="CenterScreen"
    Background="#141414"
    Foreground="#E8E8E8"
    FontFamily="Microsoft YaHei UI"
    FontSize="14"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="RootBrush" Color="#141414" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#171717" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#212121" />
        <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#2B2B2B" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="TextBrush" Color="#E8E8E8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A7A7A7" />
        <SolidColorBrush x:Key="WeakBrush" Color="#8A8A8A" />
        <SolidColorBrush x:Key="VioletBrush" Color="#8B80FF" />
        <SolidColorBrush x:Key="GreenBrush" Color="#0EFDD3" />
        <SolidColorBrush x:Key="AmberBrush" Color="#F2B84B" />
        <SolidColorBrush x:Key="RedBrush" Color="#DA3639" />

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceStrongBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.70" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Background" Value="#E8E8E8" />
            <Setter Property="Foreground" Value="#141414" />
            <Setter Property="BorderBrush" Value="#E8E8E8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="46" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Background" Value="{StaticResource RedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="46" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBackground" Property="Background" Value="#242424" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#181818" />
            <Setter Property="BorderBrush" Value="#4F4F4F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="MinHeight" Value="40" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource VioletBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Grid.Column="0" Width="36" Height="20" HorizontalAlignment="Left" Background="#4F4F4F" CornerRadius="10">
                                <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3" HorizontalAlignment="Left" Fill="#E8E8E8" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource VioletBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="#181818" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#34323F" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#242424" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Height" Value="30" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource RootBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="184" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#2B2B2B" BorderThickness="0,0,0,1" Background="#141414">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#2B2B2B">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE769;" FontSize="20" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="雷神自动暂停（非官方）" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="本地守护控制台" FontSize="11" Foreground="{StaticResource WeakBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="{StaticResource WeakBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="HeaderStatusText" Text="正在检查" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" ToolTip="刷新状态" AutomationProperties.Name="刷新状态" />
                    <Button x:Name="OpenLeigodButton" Style="{StaticResource FlatButtonStyle}" Margin="8,0,0,0" ToolTip="打开雷神加速器">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;" Margin="0,0,8,0" />
                            <TextBlock Text="打开雷神" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#2B2B2B" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Margin="12,16,12,18" Padding="12" Background="#212121" BorderBrush="#343434" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="后台监控" Foreground="{StaticResource WeakBrush}" FontSize="11" />
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Ellipse x:Name="SidebarStatusDot" Width="9" Height="9" Fill="{StaticResource WeakBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="SidebarStatusText" Text="正在检查" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1">
                    <Grid x:Name="OverviewNavHost" Background="#2B2B2B">
                        <Border x:Name="OverviewIndicator" Width="3" Background="{StaticResource VioletBrush}" HorizontalAlignment="Left" />
                        <Button x:Name="OverviewNavButton" Style="{StaticResource NavButtonStyle}" Foreground="{StaticResource TextBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="17" Margin="0,0,12,0" />
                                <TextBlock Text="概览" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid x:Name="SettingsNavHost" Background="Transparent">
                        <Border x:Name="SettingsIndicator" Width="3" Background="{StaticResource VioletBrush}" HorizontalAlignment="Left" Visibility="Collapsed" />
                        <Button x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="17" Margin="0,0,12,0" />
                                <TextBlock Text="规则设置" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid x:Name="LogsNavHost" Background="Transparent">
                        <Border x:Name="LogsIndicator" Width="3" Background="{StaticResource VioletBrush}" HorizontalAlignment="Left" Visibility="Collapsed" />
                        <Button x:Name="LogsNavButton" Style="{StaticResource NavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="17" Margin="0,0,12,0" />
                                <TextBlock Text="运行日志" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="16,0,16,16">
                    <CheckBox x:Name="AutoStartToggle" Style="{StaticResource ToggleSwitchStyle}" Content="开机自启" Margin="0,0,0,14" />
                    <TextBlock Text="UI v1.1" Foreground="{StaticResource WeakBrush}" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid x:Name="OverviewPanel" Margin="28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="138" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="92" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="自动暂停" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="当前会话" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="210" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="MainStatusDot" Width="11" Height="11" Fill="{StaticResource WeakBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock x:Name="MainStatusText" Text="正在检查后台监控" FontSize="25" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock x:Name="MainStatusDetail" Text="正在读取本地状态" Foreground="{StaticResource MutedBrush}" Margin="21,8,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="LastEventText" Text="暂无活动记录" Foreground="{StaticResource WeakBrush}" FontSize="12" Margin="21,6,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="MonitorActionButton" Style="{StaticResource PrimaryButtonStyle}" MinWidth="180">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="MonitorActionIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="16" Margin="0,0,9,0" />
                                    <TextBlock x:Name="MonitorActionText" Text="启动监控" FontSize="15" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="18,14">
                            <TextBlock Text="雷神客户端" Foreground="{StaticResource WeakBrush}" FontSize="11" />
                            <TextBlock x:Name="ClientStatusText" Text="正在检查" Margin="0,7,0,0" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#3A3A3A" Margin="0,14" />
                        <StackPanel Grid.Column="2" Margin="18,14">
                            <TextBlock Text="账号时长" Foreground="{StaticResource WeakBrush}" FontSize="11" />
                            <TextBlock x:Name="AccountStatusText" Text="正在检查" Margin="0,7,0,0" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <Border Grid.Column="3" Background="#3A3A3A" Margin="0,14" />
                        <StackPanel Grid.Column="4" Margin="18,14">
                            <TextBlock Text="目标游戏" Foreground="{StaticResource WeakBrush}" FontSize="11" />
                            <TextBlock x:Name="GameStatusText" Text="正在检查" Margin="0,7,0,0" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="最近活动" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="ActivityText" Grid.Row="2" Text="暂无活动记录" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="24" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                        <StackPanel>
                            <TextBlock Text="当前规则" Style="{StaticResource SectionTitleStyle}" />
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="退出宽限" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="GraceSummaryText" Grid.Column="1" Text="120 秒" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="客户端关闭" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="ClientCloseRuleText" Grid.Column="1" Text="启用" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="游戏识别" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="GameCountText" Grid.Column="1" Text="自动 + 0 个" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsPanel" Margin="28,22" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="规则设置" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="自动识别与触发条件" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="手动补充进程" Style="{StaticResource SectionTitleStyle}" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ProcessInput" Grid.Column="0" Style="{StaticResource DarkTextBoxStyle}" ToolTip="输入需要补充的完整 exe 进程名" />
                                <Button x:Name="AddProcessButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE710;" ToolTip="添加补充进程" AutomationProperties.Name="添加补充进程" />
                            </Grid>
                            <ListView x:Name="GameList" Grid.Row="4">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="进程名" Width="230" DisplayMemberBinding="{Binding Process}" />
                                        <GridViewColumn Header="状态" Width="90" DisplayMemberBinding="{Binding Status}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <Button x:Name="RemoveProcessButton" Grid.Row="6" Style="{StaticResource FlatButtonStyle}" HorizontalAlignment="Left" ToolTip="移除选中的进程">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" Margin="0,0,8,0" />
                                    <TextBlock Text="移除" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="触发规则" Style="{StaticResource SectionTitleStyle}" />

                            <CheckBox x:Name="AutoDetectGamesToggle" Style="{StaticResource ToggleSwitchStyle}" Content="自动识别雷神启动的游戏" Margin="0,8,0,0" />

                            <TextBlock Text="游戏退出宽限（秒）" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ExitGraceMinusButton" Grid.Column="0" Style="{StaticResource IconButtonStyle}" Content="&#xE738;" ToolTip="减少 30 秒" />
                                <TextBox x:Name="ExitGraceInput" Grid.Column="2" Style="{StaticResource DarkTextBoxStyle}" HorizontalContentAlignment="Center" />
                                <Button x:Name="ExitGracePlusButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}" Content="&#xE710;" ToolTip="增加 30 秒" />
                            </Grid>

                            <TextBlock Text="启动观察期（秒）" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="StartupGraceMinusButton" Grid.Column="0" Style="{StaticResource IconButtonStyle}" Content="&#xE738;" ToolTip="减少 30 秒" />
                                <TextBox x:Name="StartupGraceInput" Grid.Column="2" Style="{StaticResource DarkTextBoxStyle}" HorizontalContentAlignment="Center" />
                                <Button x:Name="StartupGracePlusButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}" Content="&#xE710;" ToolTip="增加 30 秒" />
                            </Grid>

                            <CheckBox x:Name="PauseOnClientCloseToggle" Style="{StaticResource ToggleSwitchStyle}" Content="客户端关闭后暂停" Margin="0,10,0,0" />
                            <CheckBox x:Name="NotificationsToggle" Style="{StaticResource ToggleSwitchStyle}" Content="系统通知" Margin="0,7,0,0" />
                            <CheckBox x:Name="NeverStartedToggle" Style="{StaticResource ToggleSwitchStyle}" Content="未检测到游戏时暂停" Margin="0,7,0,0" />
                            <CheckBox x:Name="StaleSessionToggle" Style="{StaticResource ToggleSwitchStyle}" Content="启动时处理遗留计时" Margin="0,7,0,0" />
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SettingsHintText" Text="设置未修改" Foreground="{StaticResource WeakBrush}" VerticalAlignment="Center" />
                    <Button x:Name="SaveSettingsButton" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Margin="0,0,8,0" />
                            <TextBlock Text="保存并应用" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <Grid x:Name="LogsPanel" Margin="28,22" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="运行日志" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="最近 200 行本地监控记录" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button x:Name="OpenLogFolderButton" Style="{StaticResource IconButtonStyle}" Content="&#xE838;" ToolTip="打开日志目录" AutomationProperties.Name="打开日志目录" />
                        <Button x:Name="RefreshLogButton" Style="{StaticResource IconButtonStyle}" Content="&#xE72C;" Margin="8,0,0,0" ToolTip="刷新日志" AutomationProperties.Name="刷新日志" />
                    </StackPanel>
                </Grid>
                <TextBox x:Name="LogTextBox" Grid.Row="2" Style="{StaticResource DarkTextBoxStyle}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="14" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#111111" BorderBrush="#2B2B2B" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterMessageText" Text="准备就绪" Foreground="{StaticResource WeakBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="本地逻辑 · 账号状态经雷神 HTTPS 接口查询" Foreground="{StaticResource WeakBrush}" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
